rules_version = '2';

// Reglas de Firestore para Angell Boutique
// Pegar en: Firebase Console > Firestore Database > Reglas
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo de productos:
    // - LEER: cualquiera (la tienda es pública)
    // - ESCRIBIR: solo usuarios autenticados (tú, desde el panel admin)
    match /products/{product} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Cualquier otra colección: denegado por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// OPCIONAL (más estricto): permitir escribir solo a TU correo específico.
// Reemplaza la línea "allow write" de products por esta:
//   allow write: if request.auth != null
//                && request.auth.token.email == 'tu-correo-aqui@gmail.com';
